# Project to open: a project folder or a *.code-workspace file.
# It is also where dw.json is looked up (project root or one level below, e.g. source/dw.json).
# May be left empty when the dotfiles below already declare the project.
LOCAL_PROJECT_PATH="C:/path/to/your/sfcc_project"

# Optional. dotfiles checkout, used to fill LOCAL_PROJECT_PATH (from its
# vscode/workspaces/sfcc.code-workspace or SFCC_PROJECT_DIR) and LAUNCH_EDITOR
# (from DOTFILES_EDITOR). Defaults to $HOME/Github/dotfiles.
DOTFILES_DIR=

# "code" or "zed". Empty = the dotfiles' choice, or "code".
LAUNCH_EDITOR=

# Optional. When empty they are read from dw.json:
#   SFCC_REALM / SFCC_INSTANCE  <- "hostname" (<realm>-<instance>.dx.commercecloud.salesforce.com)
#   SFCC_OAUTH_CLIENT_ID        <- "client-id"
SFCC_REALM=
SFCC_INSTANCE=
SFCC_OAUTH_CLIENT_ID=

# Optional. Explicit dw.json path, when it does not live under LOCAL_PROJECT_PATH.
DW_JSON_PATH=

POLL_INTERVAL=15
MAX_TIMEOUT=900
